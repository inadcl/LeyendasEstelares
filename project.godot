; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Leyendas Estelares"
config/description="Exploración espacial narrativa por hexágonos, con decisiones y consecuencias."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Content="*res://scripts/content.gd"
GameState="*res://scripts/game_state.gd"
Sfx="*res://scripts/audio.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.031, 0.039, 0.07, 1)

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation", "res://translations/strings.es.translation")
locale/fallback="en"
